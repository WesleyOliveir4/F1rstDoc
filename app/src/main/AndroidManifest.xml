<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"/>

    <application
        android:name=".AppApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_f1rstdoc"
        android:roundIcon="@mipmap/ic_f1rstdoc_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.F1rstDoc"
        tools:targetApi="31">
            <activity
                android:name=".presentation.splash.view.SplashActivity"
                android:theme="@style/Theme.full"
                android:exported="true">
                <intent-filter>
                    <action android:name="android.intent.action.MAIN" />

                    <category android:name="android.intent.category.LAUNCHER" />
                </intent-filter>
            </activity>

        <activity
            android:name=".presentation.login.view.LoginActivity"
            android:theme="@style/Theme.full"
            android:exported="false">
            <meta-data
                android:name="android.app.lib_name"
                android:value="" />
        </activity>


        <activity
            android:name=".presentation.register.view.RegisterActivity"
            android:theme="@style/Theme.fullNoTitle"
            android:exported="false"
            android:parentActivityName=".presentation.login.view.LoginActivity">
            <meta-data
                android:name="android.app.lib_name"
                android:value="" />
        </activity>

        <activity
            android:name=".presentation.docs.view.HomeActivity"
            android:exported="true">
            <meta-data
                android:name="android.app.lib_name"
                android:value="" />
        </activity>

    </application>


</manifest>